# ── Supabase ───────────────────────────────────────────────────
# Project Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Project Settings → API → service_role key (NEVER expose to frontend)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Groq (free AI — no credit card needed) ────────────────────
# Sign up at console.groq.com → API Keys → Create Key
GROQ_API_KEY=gsk_...

# ── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=hello@pockethost.in

# ── Server ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=5001
DOMAIN=pockethost.in
ALLOWED_ORIGINS=https://pockethost.in,https://www.pockethost.in

# ── Admin panel secret ─────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your-very-strong-random-secret-here

# ── Rate limiting ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_MAX=20
